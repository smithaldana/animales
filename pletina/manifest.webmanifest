{
  "name": "Pletina",
  "short_name": "Pletina",
  "description": "Tu reproductor de MP3 y MP4: listas, cola y vúmetros, sin anuncios y sin conexión.",
  "lang": "es",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#121417",
  "theme_color": "#121417",
  "categories": ["music", "entertainment"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "media", "accept": ["audio/*", "video/*", ".mp3", ".m4a", ".mp4", ".webm", ".ogg", ".opus", ".flac", ".wav"] }
      ]
    }
  }
}
